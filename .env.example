# Required: Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Optional: your server ID. Slash commands show up instantly there.
GUILD_ID=

# Optional: channel IDs (comma separated) where every photo posted is collected automatically,
# without running /pdf start first. DMs with the bot always auto-collect.
AUTO_COLLECT_CHANNELS=

# Optional tuning
SESSION_TTL_HOURS=12
MAX_PHOTOS=300
